{
  "opencollection": "1.0.0",
  "info": {
    "name": "Super Payments Checkout Sessions Payment Methods API",
    "version": "2026-04-01"
  },
  "items": [
    {
      "info": {
        "name": "Payment Methods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payment Methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/payment-methods",
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "query"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "usage",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "by",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint lists your previously created payment methods in a paged list. Additional filters and sorting criteria may be provided as query parameters."
        },
        {
          "info": {
            "name": "Create Payment Method",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.superpayments.com/2026-04-01/payment-methods",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint creates a new payment method that will be associated with a particular customer. This payment method, once set up, can be used to create off-session payments against a given customer."
        },
        {
          "info": {
            "name": "Create Setup Intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.superpayments.com/2026-04-01/payment-methods/:id/setup-intents",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint creates a setup intent against a previously created payment method. The setup intent is used to orchestrate the process that allows a customer to set up their payment method (e.g. debit card) for future usage in off-session payments. It returns a session token that may be passed to the <super-card> Web Component to begin the setup process."
        },
        {
          "info": {
            "name": "Get Payment Method",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/payment-methods/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint returns a previously created payment method, including its current status. It requires the Super payment method ID that was provided upon successful creation of the payment method."
        },
        {
          "info": {
            "name": "List Setup Intents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/payment-methods/setup-intents",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint lists all existing setup intents."
        }
      ]
    }
  ],
  "bundled": true
}