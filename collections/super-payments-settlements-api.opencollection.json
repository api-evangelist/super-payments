{
  "opencollection": "1.0.0",
  "info": {
    "name": "Super Payments Checkout Sessions Settlements API",
    "version": "2026-04-01"
  },
  "items": [
    {
      "info": {
        "name": "Settlements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get settlement detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/settlements/:settlementId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "settlementId",
                "value": "",
                "type": "path",
                "description": "Settlement identifier."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Fetch a single settlement and its payments/statistics. Provide Accept"
        },
        {
          "info": {
            "name": "Get settlement reconciliation rows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/settlements/:settlementId/reconciliation",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "settlementId",
                "value": "",
                "type": "path",
                "description": "Settlement identifier."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of reconciliation rows per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Opaque cursor returned by previous responses."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Return ledger reconciliation items for a settlement, with pagination. Provide Accept"
        },
        {
          "info": {
            "name": "List settlements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.superpayments.com/2026-04-01/settlements",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "settlementReference",
                "value": "",
                "type": "query",
                "description": "Filter by prefix of settlement reference (case-insensitive)."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Opaque cursor returned by previous responses."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve paginated settlement batches for the current merchant. Provide Accept"
        }
      ]
    }
  ],
  "bundled": true
}